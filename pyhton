    # --------------------------------------------------------------------------
    # SELEÇÃO DA PASTA E TEMA
    # --------------------------------------------------------------------------
    def selecionar_pasta(self):
        pasta = filedialog.askdirectory(title="Selecione a pasta raiz dos extratos", initialdir=self.caminho_pasta.get() or str(Path.home()))
        if pasta:
            self.caminho_pasta.set(pasta)
            self.limpar_resultado()

    def alternar_tema(self):
        self.modo_escuro = not self.modo_escuro
        ctk.set_appearance_mode("Dark" if self.modo_escuro else "Light")
        self.botao_tema.configure(text="☀ Claro" if self.modo_escuro else "☾ Escuro")

    def limpar_resultado(self):
        self.arquivo_saida = None
        self.tipo_processamento = ""
        self.status.set("Selecione a pasta raiz dos extratos para iniciar.")
        self.percentual.set("0%")
        self.progresso.set(0)
        self.resultado.set("")
        self.botao_abrir.configure(state="disabled")

    # --------------------------------------------------------------------------
    # CONTROLE DO PROCESSAMENTO
    # --------------------------------------------------------------------------
    def iniciar(self, tipo: str):
        if self.processamento_ativo:
            return
        if not self.caminho_pasta.get().strip():
            messagebox.showerror("Pasta inválida", "Selecione uma pasta válida.")
            return
        pasta = Path(self.caminho_pasta.get().strip().strip('"')).expanduser()
        if not pasta.is_dir():
            messagebox.showerror("Pasta inválida", "Selecione uma pasta válida.")
            return
        self.tipo_processamento = tipo
        self.processamento_ativo = True
        for botao in [self.botao_correntes, self.botao_selecionar, self.botao_abrir]:
            botao.configure(state="disabled")
        self.progresso.set(0)
        self.percentual.set("0%")
        descricao = "movimentações"
        self.status.set(f"Localizando PDFs de {descricao}...")
        self.arquivo_saida = None
        self.resultado.set("")
        self.label_resultado.configure(text_color=(self.VERDE, "#7FC49B"))
        threading.Thread(target=self.executar, args=(pasta, tipo), daemon=True).start()

    # --------------------------------------------------------------------------
    # PROCESSAMENTO EM SEGUNDO PLANO E EVENTOS
    # --------------------------------------------------------------------------
    def consumir_eventos(self):
        try:
            while True:
                tipo, dados = self.eventos.get_nowait()
                if tipo == "progresso":
                    self.atualizar(*dados)
                elif tipo == "sucesso":
                    self.arquivo_saida, quantidade, erros, arquivos = dados
                    self.sucesso(quantidade, erros, arquivos)
                elif tipo == "erro":
                    self.erro(dados)
        except queue.Empty:
            pass
        self.raiz.after(100, self.consumir_eventos)

    def executar(self, pasta: Path, tipo: str):
        try:
            registros, erros, arquivos = movimentacao_processar_todos_extratos(
                pasta, lambda a, t, n: self.eventos.put(("progresso", (a, t, n))))
            destino = movimentacao_salvar_planilha(registros, erros, pasta)
            self.eventos.put(("sucesso", (destino, len(registros), erros, arquivos)))
        except Exception as erro:
            self.eventos.put(("erro", str(erro)))

    # --------------------------------------------------------------------------
    # PROGRESSO E RESULTADO
    # --------------------------------------------------------------------------
    def atualizar(self, atual, total, nome):
        percentual = int(atual / total * 100) if total else 0
        self.progresso.set(atual / total if total else 0)
        self.percentual.set(f"{percentual}%")
        self.status.set(f"Processando {atual} de {total}: {nome}")

    def sucesso(self, total, erros, arquivos):
        self.processamento_ativo = False
        self.progresso.set(1)
        self.percentual.set("100%")
        self.status.set("Processamento concluído.")
        aviso = f"\n{len(erros)} arquivo(s) apresentaram erro. Consulte a aba 'Erros de leitura'." if erros else ""
        mensagem = f"Concluído: {arquivos} PDF(s) importado(s); {total} linha(s), incluindo saldos anteriores.{aviso}\nPlanilha criada: {self.arquivo_saida}"
        self.resultado.set(mensagem)
        self.botao_correntes.configure(state="normal")
        self.botao_selecionar.configure(state="normal")
        self.botao_abrir.configure(state="normal")
        messagebox.showinfo("Processamento concluído", mensagem)

    def erro(self, mensagem):
        self.processamento_ativo = False
        self.status.set("Processamento não concluído.")
        self.resultado.set(f"Erro: {mensagem}")
        self.label_resultado.configure(text_color=(self.VERMELHO, "#E58C82"))
        self.botao_correntes.configure(state="normal")
        self.botao_selecionar.configure(state="normal")
        self.botao_abrir.configure(state="disabled")
        messagebox.showerror("Erro no processamento", mensagem)

    # --------------------------------------------------------------------------
    # ABERTURA DA PLANILHA E FECHAMENTO
    # --------------------------------------------------------------------------
    def abrir_planilha(self):
        if not self.arquivo_saida or not self.arquivo_saida.exists():
            messagebox.showwarning("Planilha não encontrada", "A planilha de resultado não está disponível.")
            return
        try:
            if sys.platform == "win32":
                os.startfile(self.arquivo_saida)
            else:
                subprocess.Popen(["open" if sys.platform == "darwin" else "xdg-open", str(self.arquivo_saida)])
        except OSError as erro:
            messagebox.showerror("Não foi possível abrir", str(erro))

    def fechar_aplicacao(self):
        if self.processamento_ativo:
            messagebox.showwarning("Processamento em andamento", "Aguarde o processamento terminar antes de fechar o programa.")
            return
        self.raiz.destroy()


# --------------------------------------------------------------------------
# INICIALIZAÇÃO DO APLICATIVO
# --------------------------------------------------------------------------
def main():
    if sys.platform == "win32":
        try:
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("br.com.leitor.extratos.movimentacoes")
        except Exception:
