def movimentacao_identificar_caixa(texto: str) -> bool:
    return bool(
        re.search(
            r"Extrato\s+por\s+per[ií]odo",
            texto,
            re.I,
        )
        and re.search(
            r"\bConta:\s*\d+\s*\|\s*\d+\s*\|\s*[\d.-]+",
            texto,
            re.I,
        )
    )


def movimentacao_numero_caixa(
    valor: str,
    indicador: str = "",
) -> Decimal:
    numero = movimentacao_numero_br(valor)

    indicador = indicador.strip().upper()

    if indicador == "D":
        return -abs(numero)

    if indicador == "C":
        return abs(numero)

    return numero

def movimentacao_extrair_conta_caixa(texto: str) -> str:
    encontrado = re.search(
        r"\bConta:\s*"
        r"\d+\s*\|\s*"
        r"\d+\s*\|\s*"
        r"(\d+)\s*-\s*(\d+)",
        texto,
        re.I,
    )

    if not encontrado:
        raise ValueError(
            "Conta da Caixa não encontrada no formato "
            "'agência | operação | conta-dígito'."
        )

    numero = encontrado.group(1).lstrip("0") or "0"
    digito = encontrado.group(2)

    return f"{numero}-{digito}"

def movimentacao_extrair_registros_caixa(
    paginas,
    arquivo: str,
):
    # Limpa cada linha antes de juntar o texto das páginas.
    linhas_limpas = []

    for pagina in paginas:
        for linha in pagina:
            texto_linha = movimentacao_texto_linha(linha).strip()

            if not texto_linha:
                continue

            # O endereço contém datas que não são lançamentos.
            if re.search(
                r"https?://|gerenciador\.caixa\.gov\.br|hdnDataInicio=|hdnDataFinal=",
                texto_linha,
                re.I,
            ):
                continue

            # Cabeçalho de impressão repetido nas páginas.
            if re.match(
                r"^\d{2}/\d{2}/\d{4},?\s+\d{2}:\d{2}",
                texto_linha,
            ):
                continue

            if re.fullmatch(r"\d+\s*/\s*\d+", texto_linha):
                continue

            linhas_limpas.append(texto_linha)

    texto = re.sub(r"\s+", " ", " ".join(linhas_limpas)).strip()

    conta = movimentacao_extrair_conta_caixa(texto)

    padrao_numero = r"(?:\d{1,3}(?:\.\d{3})+|\d+),\d{2}"

    # O saldo anterior possui dois valores:
    # valor do lançamento e saldo da conta.
    saldo_anterior_match = re.search(
        rf"\bSALDO\s+ANTERIOR\s+"
        rf"(?P<valor>{padrao_numero})"
        rf"(?:\s*(?P<tipo_valor>[CD])\b)?\s+"
        rf"(?P<saldo>{padrao_numero})"
        rf"\s*(?P<tipo_saldo>[CD])\b",
        texto,
        re.I,
    )

    if not saldo_anterior_match:
        raise ValueError(
            "Saldo anterior da Caixa não encontrado."
        )

    saldo_anterior = movimentacao_numero_caixa(
        saldo_anterior_match.group("saldo"),
        saldo_anterior_match.group("tipo_saldo"),
    )

    registros = [
        movimentacao_criar_registro(
            arquivo,
            "Caixa",
            conta,
            None,
            "SALDO ANTERIOR",
            None,
            saldo_anterior,
        )
    ]

    corpo = texto[saldo_anterior_match.end():]

    # Remove o rodapé antes de interpretar os lançamentos.
    corpo = re.split(
        r"\*\s*661\b"
        r"|\bSAC\s+CAIXA\b"
        r"|\bOuvidoria\b"
        r"|\bAl[oô]\s+CAIXA\b",
        corpo,
        maxsplit=1,
        flags=re.I,
    )[0]

    padrao_data = re.compile(
        r"\b\d{2}/\d{2}/\d{4}\b"
    )

    datas = list(padrao_data.finditer(corpo))

    padrao_lancamento = re.compile(
        rf"^(?P<data>\d{{2}}/\d{{2}}/\d{{4}})\s+"
        rf"(?P<documento>\d+)\s+"
        rf"(?P<descricao>.+?)\s+"
        rf"(?P<valor>{padrao_numero})"
        rf"\s*(?P<tipo_valor>[CD])\s+"
        rf"(?P<saldo>{padrao_numero})"
        rf"\s*(?P<tipo_saldo>[CD])\b",
        re.I,
    )

    saldo_referencia = saldo_anterior

    for indice, marcador in enumerate(datas):
        inicio = marcador.start()

        if indice + 1 < len(datas):
            fim = datas[indice + 1].start()
        else:
            fim = len(corpo)

        trecho = corpo[inicio:fim].strip()

        encontrado = padrao_lancamento.match(trecho)

        if not encontrado:
            raise ValueError(
                "Lançamento da Caixa não reconhecido: "
                f"{trecho[:200]}"
            )

        data_texto = encontrado.group("data")
        data = datetime.strptime(
            data_texto,
            "%d/%m/%Y",
        )

        descricao = re.sub(
            r"\s+",
            " ",
            encontrado.group("descricao"),
        ).strip()

        valor = movimentacao_numero_caixa(
            encontrado.group("valor"),
            encontrado.group("tipo_valor"),
        )

        saldo = movimentacao_numero_caixa(
            encontrado.group("saldo"),
            encontrado.group("tipo_saldo"),
        )

        # SALDO DIA é apenas uma linha de conferência.
        if re.fullmatch(
            r"SALDO\s+DIA",
            descricao,
            re.I,
        ):
            if saldo != saldo_referencia:
                raise ValueError(
                    f"Saldo dia divergente em {data_texto}: "
                    f"último saldo = {saldo_referencia}; "
                    f"saldo dia = {saldo}."
                )

            continue

        esperado = saldo_referencia + valor

        if esperado != saldo:
            raise ValueError(
                f"Saldo divergente em {data_texto}: "
                f"anterior + valor = {esperado}; "
                f"PDF = {saldo}."
            )

        registros.append(
            movimentacao_criar_registro(
                arquivo,
                "Caixa",
                conta,
                data,
                descricao,
                valor,
                saldo,
            )
        )

        saldo_referencia = saldo

    # Evita aceitar silenciosamente um conteúdo que não foi interpretado.
    if not datas and corpo.strip():
        raise ValueError(
            "Há conteúdo após o saldo anterior, mas nenhuma "
            "movimentação da Caixa foi reconhecida."
        )

    return registros



def movimentacao_processar_extrato_caixa(
    caminho_pdf: Path,
    paginas=None,
):
    if paginas is None:
        paginas = movimentacao_extrair_paginas(
            caminho_pdf
        )

    return movimentacao_extrair_registros_caixa(
        paginas,
        caminho_pdf.stem,
    )

# --------------------------------------------------------------------------
# BB — IDENTIFICAÇÃO DO MODELO
# --------------------------------------------------------------------------
def movimentacao_identificar_bb(texto: str) -> bool:
    return bool(
        re.search(
            r"Cliente\s*-\s*Conta\s+atual",
            texto,
            re.I,
        )
        and re.search(
            r"Conta\s+corrente\s+\d[\d.]*-\d+",
            texto,
            re.I,
        )
        and re.search(
            r"Lançamentos",
            texto,
            re.I,
        )
    )


# --------------------------------------------------------------------------
# BB — CONVERSÃO DOS VALORES COM INDICADORES C/D
# --------------------------------------------------------------------------
def movimentacao_numero_bb(
    valor: str,
    indicador: str,
) -> Decimal:
    numero = movimentacao_numero_br(valor)
    indicador = indicador.strip().upper()

    if indicador == "D":
        return -abs(numero)

    if indicador == "C":
        return abs(numero)

    raise ValueError(
        f"Indicador de valor do BB inválido: {indicador!r}"
    )


# --------------------------------------------------------------------------
# BB — EXTRAÇÃO DA CONTA
# --------------------------------------------------------------------------
def movimentacao_extrair_conta_bb(texto: str) -> str:
    encontrado = re.search(
        r"\bConta\s+corrente\s+"
        r"(\d[\d.]*-\d+)\b",
        texto,
        re.I,
    )

    if not encontrado:
        raise ValueError(
            "Número da conta corrente do BB não encontrado."
        )

    return encontrado.group(1).replace(".", "")


# --------------------------------------------------------------------------
# BB — LIMPEZA DE CABEÇALHOS E RODAPÉS
# --------------------------------------------------------------------------
def movimentacao_limpar_texto_bb(paginas) -> str:
    linhas_limpas = []

    for pagina in paginas:
        for linha in pagina:
            texto_linha = movimentacao_texto_linha(
                linha
            ).strip()

            if not texto_linha:
                continue

            # Data e horário da impressão do navegador.
            if re.fullmatch(
                r"\d{2}/\d{2}/\d{4},?\s+"
                r"\d{2}:\d{2}(?::\d{2})?",
                texto_linha,
            ):
                continue

            # Nome do banco no rodapé do navegador.
            if re.fullmatch(
                r"Banco\s+do\s+Brasil",
                texto_linha,
                re.I,
            ):
                continue

            # Endereço do site impresso no rodapé.
            if re.search(
                r"https?://|autoatendimento\.bb\.com\.br",
                texto_linha,
                re.I,
            ):
                continue

            # Numeração das páginas: 1/4, 2/4 etc.
            if re.fullmatch(
                r"\d+\s*/\s*\d+",
                texto_linha,
            ):
                continue

            linhas_limpas.append(texto_linha)

    texto = " ".join(linhas_limpas)

    texto = re.sub(
        r"\s+",
        " ",
        texto,
    ).strip()

    # Remove as observações e mensagens posteriores ao extrato.
    texto = re.split(
        r"\*{3}"
        r"|\bOBSERVAÇÕES\s*:"
        r"|\bTransação\s+efetuada\s+com\s+sucesso",
        texto,
        maxsplit=1,
        flags=re.I,
    )[0]

    return texto.strip()


# --------------------------------------------------------------------------
# BB — SALDO ANTERIOR E MOVIMENTAÇÕES
# --------------------------------------------------------------------------
def movimentacao_extrair_registros_bb(
    paginas,
    arquivo: str,
):
    texto = movimentacao_limpar_texto_bb(
        paginas
    )

    conta = movimentacao_extrair_conta_bb(
        texto
    )

    padrao_numero = (
        r"(?:\d{1,3}(?:\.\d{3})+|\d+),\d{2}"
    )

    # Um lançamento começa por:
    # data, data de movimento opcional, agência, lote e histórico.
    #
    # As datas existentes dentro dos complementos não possuem
    # essa sequência e não iniciam um novo lançamento.
    padrao_inicio = re.compile(
        r"(?<!\S)"
        r"(?P<data>\d{2}/\d{2}/\d{4})\s+"
        r"(?:(?P<data_movimento>"
        r"\d{2}/\d{2}/\d{4})\s+)?"
        r"(?P<agencia>\d{4})\s+"
        r"(?P<lote>\d{5})\s+"
        r"(?P<codigo>\d{3})\s+",
        re.I,
    )

    inicios = list(
        padrao_inicio.finditer(texto)
    )

    if not inicios:
        raise ValueError(
            "Nenhum lançamento do BB foi reconhecido."
        )

    padrao_saldo = re.compile(
        rf"^(?P<saldo>{padrao_numero})"
        rf"\s*(?P<tipo>[CD])\b",
        re.I,
    )

    padrao_movimentacao = re.compile(
        rf"^(?P<descricao>.+?)\s+"
        rf"(?P<documento>\d[\d.]*)\s+"
        rf"(?P<valor>{padrao_numero})"
        rf"\s*(?P<tipo_valor>[CD])\b"
        rf"(?:\s+"
        rf"(?P<saldo>{padrao_numero})"
        rf"\s*(?P<tipo_saldo>[CD])\b"
        rf")?"
        rf"(?P<complemento>.*)$",
        re.I,
    )

    registros = []
    saldo_calculado = None
    encontrou_saldo_final = False

    for indice, inicio in enumerate(inicios):
        fim = (
            inicios[indice + 1].start()
            if indice + 1 < len(inicios)
            else len(texto)
        )

        conteudo = texto[
            inicio.end():fim
        ].strip()

        data_texto = inicio.group("data")

        data = datetime.strptime(
            data_texto,
            "%d/%m/%Y",
        )

        codigo = inicio.group("codigo")

        # --------------------------------------------------------------
        # SALDO ANTERIOR
        # --------------------------------------------------------------
        anterior = re.match(
            r"^Saldo\s+Anterior\s+",
            conteudo,
            re.I,
        )

        if anterior:
            if registros:
                raise ValueError(
                    "Saldo anterior do BB repetido ou localizado "
                    "depois das movimentações."
                )

            saldo_match = padrao_saldo.match(
                conteudo[anterior.end():].strip()
            )

            if not saldo_match:
                raise ValueError(
                    "Valor do saldo anterior do BB não reconhecido."
                )

            saldo_calculado = movimentacao_numero_bb(
                saldo_match.group("saldo"),
                saldo_match.group("tipo"),
            )

            registros.append(
                movimentacao_criar_registro(
                    arquivo,
                    "BB",
                    conta,
                    data,
                    "SALDO ANTERIOR",
                    None,
                    saldo_calculado,
                )
            )

            continue

        if saldo_calculado is None:
            raise ValueError(
                "Saldo anterior do BB não encontrado "
                "antes das movimentações."
            )

        # --------------------------------------------------------------
        # SALDO FINAL — NÃO É UMA MOVIMENTAÇÃO
        # --------------------------------------------------------------
        final = re.match(
            r"^S\s*A\s*L\s*D\s*O\b\s*",
            conteudo,
            re.I,
        )

        if codigo == "999" and final:
            saldo_match = padrao_saldo.match(
                conteudo[final.end():].strip()
            )

            if not saldo_match:
                raise ValueError(
                    "Saldo final do BB não reconhecido."
                )

            saldo_final = movimentacao_numero_bb(
                saldo_match.group("saldo"),
                saldo_match.group("tipo"),
            )

            if saldo_calculado != saldo_final:
                raise ValueError(
                    f"Saldo final divergente no BB: "
                    f"calculado = {saldo_calculado}; "
                    f"PDF = {saldo_final}."
                )

            if encontrou_saldo_final:
                raise ValueError(
                    "Linha de saldo final do BB repetida."
                )

            registros.append(
                movimentacao_criar_registro(
                    arquivo,
                    "BB",
                    conta,
                    data,
                    "SALDO FINAL",
                    None,
                    saldo_final,
                )
            )

            encontrou_saldo_final = True
            continue

        if encontrou_saldo_final:
            raise ValueError(
                "Foram encontrados lançamentos depois "
                "da linha de saldo final do BB."
            )

        # --------------------------------------------------------------
        # MOVIMENTAÇÃO NORMAL
        # --------------------------------------------------------------
        encontrado = padrao_movimentacao.fullmatch(
            conteudo
        )

        if not encontrado:
            raise ValueError(
                f"Lançamento do BB não reconhecido "
                f"em {data_texto}: {conteudo[:220]}"
            )

        descricao = encontrado.group(
            "descricao"
        ).strip()

        complemento = encontrado.group(
            "complemento"
        ).strip()

        if complemento:
            descricao = (
                f"{descricao} {complemento}"
            )

        descricao = re.sub(
            r"\s+",
            " ",
            descricao,
        ).strip()

        valor = movimentacao_numero_bb(
            encontrado.group("valor"),
            encontrado.group("tipo_valor"),
        )

        saldo_calculado += valor

        saldo_informado = None

        if encontrado.group("saldo") is not None:
            saldo_informado = movimentacao_numero_bb(
                encontrado.group("saldo"),
                encontrado.group("tipo_saldo"),
            )

            if saldo_calculado != saldo_informado:
                raise ValueError(
                    f"Saldo divergente no BB "
                    f"em {data_texto}: "
                    f"calculado = {saldo_calculado}; "
                    f"PDF = {saldo_informado}."
                )

        registros.append(
            movimentacao_criar_registro(
                arquivo,
                "BB",
                conta,
                data,
                descricao,
                valor,
                saldo_informado,
            )
        )

    if not registros:
        raise ValueError(
            "Nenhum registro do BB foi extraído."
        )

    return registros


# --------------------------------------------------------------------------
# BB — PROCESSADOR DO ARQUIVO
# --------------------------------------------------------------------------
def movimentacao_processar_extrato_bb(
    caminho_pdf: Path,
    paginas=None,
):
    if paginas is None:
        paginas = movimentacao_extrair_paginas(
            caminho_pdf
        )

    return movimentacao_extrair_registros_bb(
        paginas,
        caminho_pdf.stem,
    )

