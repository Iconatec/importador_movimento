# --------------------------------------------------------------------------
# CONFIGURAÇÕES E COLUNAS DA PLANILHA
# --------------------------------------------------------------------------
MOVIMENTACAO_COLUNAS = ["Arquivo", "Banco", "Conta", "Data", "Descrição", "Valor", "Saldo"]
MOVIMENTACAO_COLUNAS_ERROS = ["Arquivo", "Banco", "Motivo"]
MOVIMENTACAO_COR_CABECALHO = "31869B"  # RGB: 49, 134, 155
MOVIMENTACAO_NOME_ARQUIVO = "extratos_movimentacao.xlsx"
MOVIMENTACAO_MOEDA = re.compile(r"-?(?:\d{1,3}(?:\.\d{3})+|\d+),\d{2}")
MOVIMENTACAO_DATA = re.compile(r"\d{2}/\d{2}/\d{4}")

# --------------------------------------------------------------------------
# FUNÇÕES AUXILIARES
# --------------------------------------------------------------------------
def movimentacao_numero_br(texto: str) -> Decimal:
    texto = texto.strip().replace("−", "-").replace(" ", "")
    if not MOVIMENTACAO_MOEDA.fullmatch(texto):
        raise ValueError(f"Valor monetário inválido: {texto!r}")
    return Decimal(texto.replace(".", "").replace(",", "."))


def movimentacao_agrupar_linhas(palavras):
    linhas = []
    for palavra in sorted(palavras, key=lambda p: (p["top"], p["x0"])):
        if not linhas or abs(palavra["top"] - linhas[-1][0]["top"]) > 3:
            linhas.append([palavra])
        else:
            linhas[-1].append(palavra)
    return [sorted(linha, key=lambda p: p["x0"]) for linha in linhas]


def movimentacao_texto_linha(linha):
    return " ".join(p["text"] for p in linha)


def movimentacao_criar_registro(arquivo, banco, conta, data, descricao, valor, saldo):
    return {
        "Arquivo": arquivo,
        "Banco": banco,
        "Conta": conta,
        "Data": data,
        "Descrição": descricao,
        "Valor": valor,
        "Saldo": saldo,
    }


def movimentacao_extrair_paginas(caminho_pdf: Path):
    paginas = []
    with pdfplumber.open(caminho_pdf) as documento:
        for pagina in documento.pages:
            paginas.append(movimentacao_agrupar_linhas(pagina.extract_words()))
    if not any(paginas):
        raise ValueError("PDF sem texto extraível. OCR não está integrado a esta versão.")
    return paginas


def movimentacao_identificar_sicredi(texto: str) -> bool:
    return bool(re.search(r"Sicredi", texto, re.I))


def movimentacao_extrair_conta_sicredi(texto: str) -> str:
    encontrado = re.search(r"\bConta:\s*([\d.]+-\d+)\b", texto, re.I)
    if not encontrado:
        raise ValueError("Conta do Sicredi não encontrada.")
    return encontrado.group(1)


def movimentacao_extrair_registros_sicredi(paginas, arquivo: str):
    texto = "\n".join(movimentacao_texto_linha(l) for p in paginas for l in p)
    conta = movimentacao_extrair_conta_sicredi(texto)
    periodo = re.search(
        r"Período\s+de\s+(\d{2}/\d{2}/\d{4})\s+a\s+(\d{2}/\d{2}/\d{4})",
        texto, re.I,
    )
    if not periodo:
        raise ValueError("Período do extrato Sicredi não encontrado.")
    inicio, fim = [datetime.strptime(d, "%d/%m/%Y") for d in periodo.groups()]
    registros = []
    limites = None
    parar = False
    for numero_pagina, linhas in enumerate(paginas, 1):
        for linha in linhas:
            texto_linha = movimentacao_texto_linha(linha)
            if re.search(r"Lançamentos\s+Futuros", texto_linha, re.I):
                parar = True
                break
            rotulos = {p["text"].casefold(): p for p in linha}
            if all(r in rotulos for r in ("data", "descrição", "documento", "valor", "saldo")):
                limites = (rotulos["descrição"]["x0"] - 2, rotulos["documento"]["x0"] - 2)
                continue
            if limites is None:
                continue
            if re.search(r"\bSALDO\s+ANTERIOR\b", texto_linha, re.I):
                if registros:
                    raise ValueError("Saldo anterior repetido ou localizado após movimentações; conferir modelo.")
                valores = MOVIMENTACAO_MOEDA.findall(texto_linha)
                if len(valores) != 1:
                    raise ValueError("Não foi possível identificar o saldo anterior com segurança.")
                registros.append(movimentacao_criar_registro(
                    arquivo, "Sicredi", conta, None, "SALDO ANTERIOR", None,
                    movimentacao_numero_br(valores[0]),
                ))
                continue
            primeira = linha[0]["text"]
            if MOVIMENTACAO_DATA.fullmatch(primeira):
                if not registros:
                    raise ValueError("Saldo anterior não encontrado antes das movimentações.")
                data = datetime.strptime(primeira, "%d/%m/%Y")
                if not inicio <= data <= fim:
                    raise ValueError(f"Movimentação fora do período: {primeira}.")
                valores = [p for p in linha if p["x0"] >= limites[1] and MOVIMENTACAO_MOEDA.fullmatch(p["text"])]
                if len(valores) != 2:
                    raise ValueError(f"Página {numero_pagina}: valor/saldo não identificados: {texto_linha}")
                descricao = " ".join(p["text"] for p in linha if limites[0] <= p["x0"] < limites[1])
                if not descricao:
                    raise ValueError(f"Descrição vazia em {primeira}.")
                valor, saldo = [movimentacao_numero_br(p["text"]) for p in valores]
                esperado = registros[-1]["Saldo"] + valor
                if esperado != saldo:
                    raise ValueError(f"Saldo divergente em {primeira}: anterior + valor = {esperado}; PDF = {saldo}.")
                registros.append(movimentacao_criar_registro(
                    arquivo, "Sicredi", conta, data, descricao, valor, saldo,
                ))
                continue
            if registros and registros[-1]["Descrição"] != "SALDO ANTERIOR" and all(limites[0] <= p["x0"] < limites[1] for p in linha):
                registros[-1]["Descrição"] += " " + texto_linha
        if parar:
            break
    if not registros:
        raise ValueError("Saldo anterior não encontrado ou tabela de movimentações não reconhecida.")
    return registros


