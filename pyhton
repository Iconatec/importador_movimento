# ITAÚ — IDENTIFICAÇÃO DO MODELO
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# ITAÚ — IDENTIFICAÇÃO E FUNÇÕES AUXILIARES
# --------------------------------------------------------------------------
def movimentacao_identificar_itau(texto: str) -> bool:
    texto = re.sub(r"\s+", " ", texto)
    return bool(re.search(r"\bConta\s+\d+\s*-\s*\d+", texto, re.I)
                and re.search(r"Lançamentos\s+do\s+período\s*:", texto, re.I))


def movimentacao_extrair_conta_itau(texto: str) -> str:
    m = re.search(r"\bConta\s+(\d+)\s*-\s*(\d+)\b", texto, re.I)
    if not m:
        raise ValueError("Conta do Itaú não localizada.")
    return f"{m.group(1)}-{m.group(2)}"


def movimentacao_tipo_registro_itau(descricao: str) -> str:
    texto = re.sub(r"\s+", " ", descricao).strip().upper()
    if texto == "SALDO ANTERIOR":
        return "ANTERIOR"
    if texto == "SALDO TOTAL DISPONÍVEL DIA":
        return "TOTAL"
    if texto == "SALDO MOVIMENTAÇÃO CONTA":
        return "CONTA"
    if re.fullmatch(r"SALDO APLIC\. AUT\.|SDO APLIC AUT MAIS AP", texto):
        return "APLICACAO"
    if texto.startswith(("SALDO ", "SDO ")):
        raise ValueError(f"Tipo de saldo do Itaú ainda não mapeado: {descricao}.")
    return "MOVIMENTACAO"


def movimentacao_unicos_itau(valores, tolerancia=1):
    saida = []
    for valor in sorted(valores):
        if not saida or valor - saida[-1] > tolerancia:
            saida.append(valor)
    return saida


def movimentacao_celulas_itau(palavras, limites, topo, base):
    celulas = []
    for esquerda, direita in zip(limites, limites[1:]):
        selecionadas = [p for p in palavras
            if esquerda <= (p["x0"] + p["x1"]) / 2 < direita
            and topo < (p["top"] + p["bottom"]) / 2 < base]
        linhas = movimentacao_agrupar_linhas(selecionadas)
        celulas.append(" ".join(movimentacao_texto_linha(l) for l in linhas).strip())
    return celulas


# --------------------------------------------------------------------------
# ITAÚ — LEITURA DA TABELA, INCLUSIVE SEM CABEÇALHO REPETIDO
# --------------------------------------------------------------------------
def movimentacao_ler_pagina_itau(pagina, configuracao=None):
    palavras = pagina.extract_words()
    linhas = movimentacao_agrupar_linhas(palavras)
    cabecalho = None
    for linha in linhas:
        rotulos = {p["text"].casefold() for p in linha}
        if {"data", "lançamentos", "cnpj/cpf", "valor", "saldo"} <= rotulos:
            cabecalho = linha
            break
    inicio = max(p["bottom"] for p in cabecalho) if cabecalho else 0
    corte = pagina.height
    for linha in linhas:
        topo = min(p["top"] for p in linha)
        if topo < inicio:
            continue
        if re.search(
            r"Saldo\s+da\s+conta\s+corrente|Lançamentos\s+futuros"
            r"|Os\s+saldos\s+acima|atualizado\s+em|Em\s+caso\s+de\s+d[uú]vidas",
            movimentacao_texto_linha(linha), re.I):
            corte = min(corte, topo)
    horizontais = [e for e in pagina.edges
        if e["orientation"] == "h" and inicio <= e["top"] < corte]
    if not horizontais:
        if corte < pagina.height:
            return [], configuracao, True
        raise ValueError(f"Tabela do Itaú não localizada na página {pagina.page_number}.")
    limites = None
    for y in movimentacao_unicos_itau([e["top"] for e in horizontais]):
        bordas = [e for e in horizontais if abs(e["top"] - y) < 0.3]
        xs = movimentacao_unicos_itau([e[k] for e in bordas for k in ("x0", "x1")])
        if len(xs) == 7:
            limites = xs
            break
    if limites is None:
        if configuracao is None:
            raise ValueError("As seis colunas do Itaú não foram reconhecidas.")
        limites = list(configuracao)
    x_data = (limites[0] + limites[1]) / 2
    separadores = movimentacao_unicos_itau([
        e["top"] for e in horizontais if e["x0"] <= x_data <= e["x1"]])
    celulas = []
    for topo, base in zip(separadores, separadores[1:]):
        linha = movimentacao_celulas_itau(palavras, limites, topo, base)
        if any(linha):
            celulas.append(linha)
    datas = [p for p in palavras
        if limites[0] <= (p["x0"] + p["x1"]) / 2 < limites[1]
        and inicio < p["top"] < corte
        and re.fullmatch(r"\d{2}/\d{2}/\d{4}", p["text"])]
    if len(datas) != sum(bool(re.fullmatch(r"\d{2}/\d{2}/\d{4}", l[0])) for l in celulas):
        raise ValueError(f"Há linhas datadas sem divisórias completas na página {pagina.page_number}.")
    return celulas, limites, corte < pagina.height


# --------------------------------------------------------------------------
# ITAÚ — RECONSTRUÇÃO DAS CÉLULAS QUEBRADAS ENTRE PÁGINAS
# --------------------------------------------------------------------------
def movimentacao_juntar_linhas_itau(linhas):
    saida = []
    pendente = None
    for linha in linhas:
        if re.fullmatch(r"\d{2}/\d{2}/\d{4}", linha[0]):
            if pendente:
                for i in range(1, 6):
                    linha[i] = " ".join(t for t in (pendente[i], linha[i]) if t)
                pendente = None
            saida.append(linha)
        elif not linha[0] and any(linha[1:]):
            # Fragmento sem data/valor no fim de uma página: guarda
            # para a linha datada que continua na página seguinte.
            if linha[4] or linha[5]:
                raise ValueError(f"Linha monetária do Itaú sem data: {linha}")
            if pendente is None:
                pendente = linha
            else:
                pendente = [" ".join(t for t in (a, b) if t) for a, b in zip(pendente, linha)]
        else:
            raise ValueError(f"Linha de tabela do Itaú não reconhecida: {linha}")
    if pendente:
        raise ValueError(f"Fragmento do Itaú sem continuação: {pendente}")
    return saida


# --------------------------------------------------------------------------
# ITAÚ — ORGANIZAÇÃO E EXPORTAÇÃO DE TODOS OS TIPOS DE SALDO
# --------------------------------------------------------------------------
def movimentacao_organizar_itau(linhas, arquivo, conta, inicio, fim):
    lidos = []
    for data_txt, historico, razao, documento, valor_txt, saldo_txt in linhas:
        data = datetime.strptime(data_txt, "%d/%m/%Y")
        tipo = movimentacao_tipo_registro_itau(historico)
        if tipo == "MOVIMENTACAO":
            if not historico or not valor_txt or saldo_txt:
                raise ValueError(f"Colunas de movimentação inválidas em {data_txt}: {historico}.")
            descricao = " ".join(t for t in (historico, razao, documento) if t)
            valor = movimentacao_numero_br(valor_txt.replace("−", "-"))
            saldo = None
        else:
            if not saldo_txt or valor_txt:
                raise ValueError(f"Colunas de saldo inválidas em {data_txt}: {historico}.")
            descricao, valor = historico, None
            saldo = movimentacao_numero_br(saldo_txt.replace("−", "-"))
        lidos.append((data, tipo, descricao, valor, saldo))
    anteriores = [r for r in lidos if r[1] == "ANTERIOR"]
    if len(anteriores) != 1:
        raise ValueError("É necessário exatamente um saldo anterior no Itaú.")
    anterior = anteriores[0]
    if anterior[0] > inicio:
        raise ValueError("Saldo anterior do Itaú posterior ao início do período.")
    saida = [movimentacao_criar_registro(arquivo, "Itaú", conta, anterior[0], anterior[2], None, anterior[4])]
    dias = {}
    for r in lidos:
        if r[1] == "ANTERIOR":
            continue
        if not inicio <= r[0] <= fim:
            raise ValueError(f"Data fora do período do Itaú: {r[0]:%d/%m/%Y}.")
        dias.setdefault(r[0], []).append(r)
    possui_aplicacao = any(r[1] == "APLICACAO" for r in lidos)
    acumulado = anterior[4]
    for data, grupo in sorted(dias.items()):
        movimentos = [r for r in grupo if r[1] == "MOVIMENTACAO"]
        saldos = [r for r in grupo if r[1] != "MOVIMENTACAO"]
        for r in movimentos:
            acumulado += r[3]
            saida.append(movimentacao_criar_registro(arquivo, "Itaú", conta, data, r[2], r[3], None))
        # Não mistura saldo consolidado com conta e aplicação.
        # Sem saldo de aplicação, mantém a conferência simples dos modelos anteriores.
        if not possui_aplicacao:
            for r in saldos:
                if r[4] != acumulado:
                    raise ValueError(f"Saldo divergente no Itaú em {data:%d/%m/%Y}: calculado = {acumulado}; PDF = {r[4]}.")
        categorias = {}
        for r in saldos:
            if r[1] in categorias and categorias[r[1]] != r[4]:
                raise ValueError(f"Saldos conflitantes do mesmo tipo em {data:%d/%m/%Y}.")
            categorias[r[1]] = r[4]
        if {"TOTAL", "CONTA", "APLICACAO"} <= categorias.keys():
            if categorias["TOTAL"] != categorias["CONTA"] + categorias["APLICACAO"]:
                raise ValueError(f"Total diferente de conta + aplicação no Itaú em {data:%d/%m/%Y}.")
        for r in saldos:
            saida.append(movimentacao_criar_registro(arquivo, "Itaú", conta, data, r[2], None, r[4]))
    return saida


# --------------------------------------------------------------------------
# ITAÚ — PROCESSADOR DO PDF
# --------------------------------------------------------------------------
def movimentacao_processar_extrato_itau(caminho_pdf: Path, paginas=None):
    with pdfplumber.open(caminho_pdf) as pdf:
        if not pdf.pages:
            raise ValueError("PDF do Itaú sem páginas.")
        texto = re.sub(r"\s+", " ", pdf.pages[0].extract_text() or "")
        conta = movimentacao_extrair_conta_itau(texto)
        periodo = re.search(
            r"Lançamentos\s+do\s+período\s*:\s*(\d{2}/\d{2}/\d{4})"
            r"\s+at[eé]\s+(\d{2}/\d{2}/\d{4})", texto, re.I)
        if not periodo:
            raise ValueError("Período do Itaú não localizado.")
        inicio, fim = [datetime.strptime(t, "%d/%m/%Y") for t in periodo.groups()]
        if inicio > fim:
            raise ValueError("Período inválido no Itaú.")
        linhas, configuracao = [], None
        for pagina in pdf.pages:
            novas, configuracao, encerrou = movimentacao_ler_pagina_itau(pagina, configuracao)
            linhas.extend(novas)
            if encerrou:
                break
    linhas = movimentacao_juntar_linhas_itau(linhas)
    return movimentacao_organizar_itau(linhas, caminho_pdf.stem, conta, inicio, fim)

# --------------------------------------------------------------------------
# BRADESCO — IDENTIFICAÇÃO DO MODELO
# --------------------------------------------------------------------------
def movimentacao_identificar_bradesco(texto: str) -> bool:
    texto = re.sub(r"\s+", " ", texto)
    return bool(
        re.search(r"Extrato\s+de\s*:", texto, re.I)
        and re.search(r"\bDcto\.?", texto, re.I)
        and re.search(r"Cr[eé]dito\s*\(R\$\)", texto, re.I)
        and re.search(r"D[eé]bito\s*\(R\$\)", texto, re.I)
        and re.search(r"\b\d{4,5}\s*\|\s*\d{5,}-\d+", texto)
    )


def movimentacao_extrair_conta_bradesco(texto: str) -> str:
    m = re.search(r"\b\d{4,5}\s*\|\s*(\d{5,})\s*-\s*(\d+)\b", texto)
    if not m:
        m = re.search(r"\bCC\s*:\s*(\d{5,})\s*-\s*(\d+)\b", texto, re.I)
    if not m:
        raise ValueError("Conta do Bradesco não encontrada.")
    return f"{m.group(1)}-{m.group(2)}"


# --------------------------------------------------------------------------
# BRADESCO — FUNÇÕES AUXILIARES DE POSICIONAMENTO
# --------------------------------------------------------------------------
def movimentacao_unicos_bradesco(valores):
    unicos = []
    for valor in sorted(valores):
        if not unicos or valor - unicos[-1] > 1:
            unicos.append(valor)
    return unicos


def movimentacao_celulas_bradesco(palavras, limites, topo, base):
    celulas = []
    for esquerda, direita in zip(limites, limites[1:]):
        selecionadas = [p for p in palavras
            if esquerda <= (p["x0"] + p["x1"]) / 2 < direita
            and topo <= (p["top"] + p["bottom"]) / 2 < base]
        linhas = movimentacao_agrupar_linhas(selecionadas)
        celulas.append(" ".join(movimentacao_texto_linha(l) for l in linhas).strip())
    return celulas


# --------------------------------------------------------------------------
# BRADESCO — LEITURA DAS TABELAS DE MOVIMENTAÇÃO
# --------------------------------------------------------------------------
def movimentacao_tabelas_bradesco(pagina):
    palavras = pagina.extract_words()
    linhas = movimentacao_agrupar_linhas(palavras)
    corte = pagina.height
    for linha in linhas:
        if re.search(r"Saldos\s+Invest\s+F[aá]cil|SALDO\s+INVEST\s+F[AÁ]CIL",
                     movimentacao_texto_linha(linha), re.I):
            corte = min(corte, min(p["top"] for p in linha))
    cabecalhos = []
    for linha in linhas:
        rotulos = {p["text"].casefold().rstrip("."): p for p in linha}
        if {"data", "lançamento", "dcto", "crédito", "débito", "saldo"} <= rotulos.keys():
            if min(p["top"] for p in linha) < corte:
                cabecalhos.append((linha, rotulos))
    tabelas = []
    for indice, (cabecalho, rotulos) in enumerate(cabecalhos):
        inicio = max(p["bottom"] for p in cabecalho)
        fim = min(corte, min(p["top"] for p in cabecalhos[indice + 1][0])) if indice + 1 < len(cabecalhos) else corte
        bordas = [e for e in pagina.edges
            if e["orientation"] == "h" and inicio <= e["top"] <= inicio + 8]
        if not bordas:
            raise ValueError(f"Divisória do cabeçalho do Bradesco não encontrada na página {pagina.page_number}.")
        y = min(e["top"] for e in bordas)
        xs = movimentacao_unicos_bradesco([
            e[k] for e in bordas if abs(e["top"] - y) < 0.3 for k in ("x0", "x1")])
        def borda_esquerda(rotulo):
            p = rotulos[rotulo]
            centro = (p["x0"] + p["x1"]) / 2
            for a, b in zip(xs, xs[1:]):
                if a <= centro < b:
                    return a
            raise ValueError(f"Coluna não reconhecida no Bradesco: {rotulo}.")
        limites = [borda_esquerda(r) for r in ("data", "lançamento", "dcto", "crédito", "débito", "saldo")] + [xs[-1]]
        if limites != sorted(set(limites)):
            raise ValueError("Colunas do Bradesco sobrepostas ou fora de ordem.")
        totais = [p for p in palavras if p["text"].casefold() == "total"
            and limites[0] <= p["x0"] < limites[1] and y < p["top"] < fim]
        total = min(totais, key=lambda p: p["top"]) if totais else None
        if total:
            fim = total["top"]
        else:
            avisos = [min(p["top"] for p in l) for l in linhas
                if min(p["top"] for p in l) > y
                and re.search(r"Os dados acima|Últimos Lançamentos|Folha\s+\d", movimentacao_texto_linha(l), re.I)]
            if avisos:
                fim = min(fim, min(avisos))
        moeda = re.compile(r"-?(?:\d{1,3}(?:\.\d{3})+|\d+),\d{2}")
        ancoras = sorted([p for p in palavras
            if limites[5] <= (p["x0"] + p["x1"]) / 2 < limites[6]
            and y < p["top"] < fim
            and moeda.fullmatch(p["text"].replace("−", "-"))], key=lambda p:p["top"])
        centros = [(p["top"] + p["bottom"]) / 2 for p in ancoras]
        registros = []
        for i, ancora in enumerate(ancoras):
            topo = y if i == 0 else (centros[i - 1] + centros[i]) / 2
            base = fim if i + 1 == len(ancoras) else (centros[i] + centros[i + 1]) / 2
            celulas = movimentacao_celulas_bradesco(palavras, limites, topo, base)
            if celulas[-1] != ancora["text"]:
                raise ValueError(f"Saldo ambíguo no Bradesco: {celulas}.")
            registros.append(celulas)
        saldo_total = None
        if total:
            total_celulas = movimentacao_celulas_bradesco(palavras, limites, total["top"] - 1, total["bottom"] + 1)
            saldo_total = movimentacao_numero_br(total_celulas[5])
        if not registros:
            raise ValueError("Tabela de movimentação do Bradesco sem registros reconhecidos.")
        tabelas.append((registros, saldo_total))
    return tabelas, corte < pagina.height


# --------------------------------------------------------------------------
# BRADESCO — PROCESSAMENTO E CONFERÊNCIA DAS MOVIMENTAÇÕES
# --------------------------------------------------------------------------
def movimentacao_processar_extrato_bradesco(caminho_pdf: Path, paginas=None):
    # Reabre o PDF para acessar as coordenadas das colunas.
    # Mantém o parâmetro paginas por compatibilidade com o cadastro.
    saida = []
    saldo_anterior = None
    ultima_data = None
    with pdfplumber.open(caminho_pdf) as pdf:
        if not pdf.pages:
            raise ValueError("PDF do Bradesco sem páginas.")
        texto = re.sub(r"\s+", " ", pdf.pages[0].extract_text() or "")
        conta = movimentacao_extrair_conta_bradesco(texto)
        periodo = re.search(r"Entre\s+(\d{2}/\d{2}/\d{4})\s+e\s+(\d{2}/\d{2}/\d{4})", texto, re.I)
        if not periodo:
            raise ValueError("Período do Bradesco não encontrado.")
        inicio, fim = [datetime.strptime(t, "%d/%m/%Y") for t in periodo.groups()]
        if inicio > fim:
            raise ValueError("Período inválido no Bradesco.")
        for pagina in pdf.pages:
            tabelas, encerrou = movimentacao_tabelas_bradesco(pagina)
            if not tabelas and not encerrou:
                raise ValueError(f"Tabela do Bradesco não localizada na página {pagina.page_number}.")
            for registros, saldo_total in tabelas:
                for data_txt, descricao, documento, credito, debito, saldo_txt in registros:
                    saldo = movimentacao_numero_br(saldo_txt.replace("−", "-"))
                    if data_txt:
                        ultima_data = datetime.strptime(data_txt, "%d/%m/%Y")
                    if ultima_data is None:
                        raise ValueError("Movimentação do Bradesco sem data de referência.")
                    if re.fullmatch(r"SALDO\s+ANTERIOR", descricao, re.I):
                        if credito or debito:
                            raise ValueError("Saldo anterior do Bradesco possui valor de movimentação.")
                        if saldo_anterior is None:
                            if ultima_data > inicio:
                                raise ValueError("Saldo anterior posterior ao início do período do Bradesco.")
                            saida.append(movimentacao_criar_registro(
                                caminho_pdf.stem, "Bradesco", conta, ultima_data, "SALDO ANTERIOR", None, saldo))
                        elif saldo_anterior != saldo:
                            raise ValueError(f"Continuidade divergente no Bradesco: último saldo = {saldo_anterior}; saldo repetido = {saldo}.")
                        saldo_anterior = saldo
                        continue
                    if saldo_anterior is None:
                        raise ValueError("Saldo anterior do Bradesco não encontrado antes das movimentações.")
                    if not inicio <= ultima_data <= fim:
                        raise ValueError(f"Movimentação fora do período: {ultima_data:%d/%m/%Y}.")
                    if not descricao or bool(credito) == bool(debito):
                        raise ValueError(f"Crédito/débito ou descrição ambíguos no Bradesco: {descricao}.")
                    valor = abs(movimentacao_numero_br(credito)) if credito else -abs(movimentacao_numero_br(debito.replace("−", "-")))
                    esperado = saldo_anterior + valor
                    if esperado != saldo:
                        raise ValueError(f"Saldo divergente no Bradesco em {ultima_data:%d/%m/%Y}: calculado = {esperado}; PDF = {saldo}.")
                    saida.append(movimentacao_criar_registro(
                        caminho_pdf.stem, "Bradesco", conta, ultima_data, descricao, valor, saldo))
                    saldo_anterior = saldo
                if saldo_total is not None and saldo_total != saldo_anterior:
                    raise ValueError("Saldo da linha Total diverge do último lançamento do Bradesco.")
            if encerrou:
                break
    if not saida:
        raise ValueError("Nenhum registro do Bradesco foi extraído.")
    return saida



# --------------------------------------------------------------------------
# CADASTRO DOS PROCESSADORES POR BANCO
# --------------------------------------------------------------------------
# Cada banco possui identificação e processamento próprios.
MOVIMENTACAO_PROCESSADORES = {
    "Sicredi": (
        movimentacao_identificar_sicredi,
        movimentacao_processar_extrato_sicredi,
    ),
    "Caixa": (
        movimentacao_identificar_caixa,
        movimentacao_processar_extrato_caixa,
    ),
    "BB": (
        movimentacao_identificar_bb,
        movimentacao_processar_extrato_bb,
    ),
    "Itaú": (
        movimentacao_identificar_itau,
        movimentacao_processar_extrato_itau,
    ),
    
    "Bradesco": (
        movimentacao_identificar_bradesco,
        movimentacao_processar_extrato_bradesco,
    ),
}

def movimentacao_processar_arquivo(
    arquivo: Path,
):
    paginas = movimentacao_extrair_paginas(
        arquivo
    )

    texto = "\n".join(
        movimentacao_texto_linha(linha)
        for pagina in paginas
        for linha in pagina
    )

    for banco, (
        identificar,
        processar,
    ) in MOVIMENTACAO_PROCESSADORES.items():
        if identificar(texto):
            return processar(
                arquivo,
                paginas,
            )

    raise ValueError(
        "Banco/modelo não programado. "
        "Modelos disponíveis: "
        "Sicredi conta corrente, "
        "Caixa Extrato por período, "
        "BB conta corrente e "
        "Itaú Lançamentos do período."
    )

# --------------------------------------------------------------------------
# LOCALIZAÇÃO DOS ARQUIVOS E PROCESSAMENTO EM LOTE
# --------------------------------------------------------------------------
def movimentacao_encontrar_arquivos(pasta_raiz: Path):
    encontradas = [p for p in pasta_raiz.iterdir() if p.is_file() and p.suffix.lower() == ".pdf"]
    for pasta in pasta_raiz.rglob("*"):
        if not pasta.is_dir():
            continue
        nome = pasta.name.casefold()
        if nome in ("corrente", "conta corrente", "001. conta corrente") or "sicredi" in nome:
            encontradas.extend(p for p in pasta.iterdir() if p.is_file() and p.suffix.lower() == ".pdf")
    return sorted(set(p.resolve() for p in encontradas), key=lambda p: str(p).casefold())


def movimentacao_processar_todos_extratos(
    pasta_raiz: Path,
    callback=None,
):
    arquivos = movimentacao_encontrar_arquivos(
        pasta_raiz
    )

    if not arquivos:
        raise FileNotFoundError(
            "Nenhum PDF na pasta selecionada "
            "ou nas subpastas de conta corrente."
        )

    registros = []
    erros = []
    sucesso = 0
    total = len(arquivos)

    nomes_pastas_corrente = {
        "corrente",
        "conta corrente",
        "001. conta corrente",
    }

    for indice, arquivo in enumerate(
        arquivos,
        start=1,
    ):
        # Identifica o banco pela estrutura de pastas,
        # sem depender da leitura do conteúdo do PDF.
        pasta_arquivo = arquivo.parent

        if (
            pasta_arquivo.name.strip().casefold()
            in nomes_pastas_corrente
        ):
            nome_banco = pasta_arquivo.parent.name
        else:
            nome_banco = pasta_arquivo.name

        if callback:
            callback(
                indice - 1,
                total,
                arquivo.name,
            )

        try:
            resultado = movimentacao_processar_arquivo(
                arquivo
            )

            registros.extend(resultado)
            sucesso += 1

        except Exception as erro:
            motivo = (
                str(erro).strip()
                or "Falha não identificada durante a leitura."
            )

            erros.append({
                "Arquivo": arquivo.stem,
                "Banco": nome_banco,
                "Status": "Erro de leitura",
                "Motivo": motivo,
            })

        if callback:
            callback(
                indice,
                total,
                arquivo.name,
            )

    return registros, erros, sucesso

# --------------------------------------------------------------------------
# FORMATAÇÃO DAS PLANILHAS
# --------------------------------------------------------------------------
def movimentacao_formatar_aba(ws, colunas):
    borda = Border(**{k: Side(style="thin", color="D9D9D9") for k in ("left", "right", "top", "bottom")})
    for celula in ws[1]:
        celula.fill = PatternFill("solid", fgColor=MOVIMENTACAO_COR_CABECALHO)
        celula.font = Font(bold=True, color="FFFFFF")
    for linha in ws.iter_rows():
        for celula in linha:
            celula.border = borda
            celula.alignment = Alignment(vertical="center", wrap_text=True)
    for i, coluna in enumerate(colunas, 1):
        largura = min(max(len(str(ws.cell(r, i).value or "")) for r in range(1, ws.max_row + 1)) + 3, 90)
        ws.column_dimensions[get_column_letter(i)].width = max(largura, 14)
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions

# --------------------------------------------------------------------------
# EXPORTAÇÃO PARA EXCEL E REGISTRO DE ERROS
# --------------------------------------------------------------------------
def movimentacao_salvar_planilha(registros, erros, pasta_saida: Path):
    wb = Workbook()
    ws = wb.active
    ws.title = "Movimentações"
    ws.append(MOVIMENTACAO_COLUNAS)
    indices = {coluna: i for i, coluna in enumerate(MOVIMENTACAO_COLUNAS, 1)}
    for registro in registros:
        ws.append([
            float(registro[c]) if isinstance(registro.get(c), Decimal) else registro.get(c)
            for c in MOVIMENTACAO_COLUNAS
        ])
        for celula in ws[ws.max_row]:
            if isinstance(celula.value, str):
                celula.data_type = "s"
        ws.cell(ws.max_row, indices["Conta"]).number_format = "@"
        ws.cell(ws.max_row, indices["Data"]).number_format = "dd/mm/yyyy"
        for coluna in ("Valor", "Saldo"):
            ws.cell(ws.max_row, indices[coluna]).number_format = '#,##0.00;[Red]-#,##0.00'
        if registro["Descrição"] == "SALDO ANTERIOR":
            for celula in ws[ws.max_row]:
                celula.fill = PatternFill("solid", fgColor="E6E7E8")
                celula.font = Font(bold=True)
    movimentacao_formatar_aba(ws, MOVIMENTACAO_COLUNAS)
    we = wb.create_sheet("Erros de leitura")
    we.append(MOVIMENTACAO_COLUNAS_ERROS)
    for erro in erros:
        we.append([erro.get(c, "") for c in MOVIMENTACAO_COLUNAS_ERROS])
        for celula in we[we.max_row]:
            if isinstance(celula.value, str):
                celula.data_type = "s"
    movimentacao_formatar_aba(we, MOVIMENTACAO_COLUNAS_ERROS)
    destino = pasta_saida / MOVIMENTACAO_NOME_ARQUIVO
    wb.save(destino)
    return destino

